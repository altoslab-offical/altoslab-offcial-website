  "typography": {
    "font": {
      "body": { "$type": "fontFamily", "$value": "Inter, Noto Sans TC, PingFang TC, system-ui, sans-serif" },
      "mono": { "$type": "fontFamily", "$value": "SFMono-Regular, Roboto Mono, Noto Sans Mono, Consolas, Liberation Mono, monospace" }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "clamp(4rem, 15vw, 12rem)" },
      "hero": { "$type": "dimension", "$value": "clamp(3.25rem, 9.5vw, 8.5rem)" },
      "section": { "$type": "dimension", "$value": "clamp(2.25rem, 6vw, 5rem)" },
