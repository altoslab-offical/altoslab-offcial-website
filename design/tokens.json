{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "ALTOS LAB Website Tokens",
    "version": "0.5.0",
    "updatedAt": "2026-05-23",
    "description": "Primitive, semantic, component, and media tokens for the ALTOS LAB official website. The public homepage currently renders from the static index.html bundle; these tokens are the canonical contract for admin pages, product pages, and future no-visual-change migration work."
  },
  "color": {
    "primitive": {
      "black": { "$type": "color", "$value": "#030403" },
      "blackSoft": { "$type": "color", "$value": "#050505" },
      "ink950": { "$type": "color", "$value": "#070807" },
      "ink925": { "$type": "color", "$value": "#090909" },
      "ink900": { "$type": "color", "$value": "#0A0A0A" },
      "ink875": { "$type": "color", "$value": "#0D0D0D" },
      "ink850": { "$type": "color", "$value": "#0F0F0F" },
      "ink800": { "$type": "color", "$value": "#111111" },
      "ink760": { "$type": "color", "$value": "#151515" },
      "ink720": { "$type": "color", "$value": "#181818" },
      "ink680": { "$type": "color", "$value": "#202020" },
      "white": { "$type": "color", "$value": "#F7F7F2" },
      "lime500": { "$type": "color", "$value": "#C8FF00" },
      "lime400": { "$type": "color", "$value": "#D7FF3F" },
