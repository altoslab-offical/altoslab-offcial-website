    "input": {
      "height": { "$type": "dimension", "$value": "3.75rem" },
      "paddingX": { "$type": "dimension", "$value": "1.5rem" },
      "textareaMinHeight": { "$type": "dimension", "$value": "12rem" }
    },
    "project": {
      "coverRatio": { "$type": "number", "$value": 1.3333 },
      "galleryRatio": { "$type": "number", "$value": 1.6 },
      "galleryMaxImages": { "$type": "number", "$value": 15 },
      "youtubeRatio": { "$type": "number", "$value": 1.7778 },
      "activeThumbBorder": { "$type": "dimension", "$value": "2px" },
      "activeThumbInnerGap": { "$type": "dimension", "$value": "2px" }
    }
  }
