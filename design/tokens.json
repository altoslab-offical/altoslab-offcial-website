      "title": { "$type": "number", "$value": 1.12 },
      "body": { "$type": "number", "$value": 1.6 },
      "longform": { "$type": "number", "$value": 1.75 }
    },
    "letterSpacing": {
      "label": { "$type": "dimension", "$value": "0.18em" },
      "wide": { "$type": "dimension", "$value": "0.4em" }
    }
  },
  "spacing": {
    "0": { "$type": "dimension", "$value": "0" },
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "10": { "$type": "dimension", "$value": "2.5rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "20": { "$type": "dimension", "$value": "5rem" },
    "24": { "$type": "dimension", "$value": "6rem" },
    "section": { "$type": "dimension", "$value": "clamp(5rem, 9vw, 8.5rem)" },
    "gutter": { "$type": "dimension", "$value": "clamp(1.25rem, 3vw, 4rem)" }
  },
  "layout": {
    "containerNarrow": { "$type": "dimension", "$value": "900px" },
    "containerMax": { "$type": "dimension", "$value": "1180px" },
    "containerWide": { "$type": "dimension", "$value": "1440px" },
    "gridGap": { "$type": "dimension", "$value": "1px" }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "2px" },
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "12px" },
    "full": { "$type": "dimension", "$value": "999px" }
  },
  "shadow": {
    "control": { "$type": "shadow", "$value": "0 10px 26px rgba(0, 0, 0, 0.24)" },
    "panel": { "$type": "shadow", "$value": "0 24px 70px rgba(0, 0, 0, 0.34)" },
    "floating": { "$type": "shadow", "$value": "0 20px 60px rgba(0, 0, 0, 0.32)" },
    "focus": { "$type": "shadow", "$value": "0 0 0 3px rgba(200, 255, 0, 0.11)" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "150ms" },
    "base": { "$type": "duration", "$value": "200ms" },
    "section": { "$type": "duration", "$value": "320ms" }
  },
  "zIndex": {
    "base": { "$type": "number", "$value": 0 },
    "header": { "$type": "number", "$value": 40 },
    "modal": { "$type": "number", "$value": 80 },
    "toast": { "$type": "number", "$value": 100 }
