      "bgCanvas": { "$type": "color", "$value": "{color.primitive.blackSoft}" },
      "bgSurface": { "$type": "color", "$value": "{color.primitive.ink900}" },
      "bgElevated": { "$type": "color", "$value": "{color.primitive.ink800}" },
      "bgPanel": { "$type": "color", "$value": "{color.primitive.ink875}" },
      "bgField": { "$type": "color", "$value": "{color.primitive.ink720}" },
      "bgFieldFocus": { "$type": "color", "$value": "{color.primitive.ink680}" },
      "bgMedia": { "$type": "color", "$value": "{color.primitive.mediaNeutral}" },
      "textPrimary": { "$type": "color", "$value": "{color.primitive.white}" },
      "textSecondary": { "$type": "color", "$value": "rgba(247, 247, 242, 0.68)" },
