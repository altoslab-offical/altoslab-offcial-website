{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "ALTOS LAB Website Tokens",
    "version": "0.4.0",
    "updatedAt": "2026-05-23",
    "description": "Primitive, semantic, and component tokens for the ALTOS LAB official website."
  },
  "color": {
    "primitive": {
      "black": { "$type": "color", "$value": "#030403" },
      "ink950": { "$type": "color", "$value": "#070807" },
      "ink900": { "$type": "color", "$value": "#0A0A0A" },
      "ink800": { "$type": "color", "$value": "#111111" },
      "white": { "$type": "color", "$value": "#F7F7F2" },
      "lime500": { "$type": "color", "$value": "#C8FF00" },
      "lime400": { "$type": "color", "$value": "#D7FF3F" },
      "orange500": { "$type": "color", "$value": "#FF5500" },
      "red500": { "$type": "color", "$value": "#FF5C5C" }
    },
    "semantic": {
      "bgBase": { "$type": "color", "$value": "{color.primitive.black}" },
      "bgSurface": { "$type": "color", "$value": "{color.primitive.ink900}" },
      "bgElevated": { "$type": "color", "$value": "{color.primitive.ink800}" },
      "textPrimary": { "$type": "color", "$value": "{color.primitive.white}" },
      "textSecondary": { "$type": "color", "$value": "rgba(247, 247, 242, 0.68)" },
      "textMuted": { "$type": "color", "$value": "rgba(247, 247, 242, 0.46)" },
      "borderDefault": { "$type": "color", "$value": "rgba(247, 247, 242, 0.13)" },
      "borderStrong": { "$type": "color", "$value": "rgba(247, 247, 242, 0.22)" },
      "actionPrimary": { "$type": "color", "$value": "{color.primitive.lime500}" },
      "accentSystem": { "$type": "color", "$value": "{color.primitive.orange500}" }
    }
  },
  "typography": {
    "font": {
      "body": { "$type": "fontFamily", "$value": "Inter, Noto Sans TC, system-ui, sans-serif" },
      "mono": { "$type": "fontFamily", "$value": "SFMono-Regular, Roboto Mono, Noto Sans Mono, Consolas, monospace" }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "clamp(4rem, 15vw, 12rem)" },
      "hero": { "$type": "dimension", "$value": "clamp(3.25rem, 9.5vw, 8.5rem)" },
      "section": { "$type": "dimension", "$value": "clamp(2.25rem, 6vw, 5rem)" },
      "title": { "$type": "dimension", "$value": "clamp(1.35rem, 2.4vw, 2rem)" },
      "body": { "$type": "dimension", "$value": "1rem" },
      "bodyLg": { "$type": "dimension", "$value": "1.125rem" },
      "small": { "$type": "dimension", "$value": "0.875rem" },
      "caption": { "$type": "dimension", "$value": "0.75rem" }
    },
    "lineHeight": {
      "display": { "$type": "number", "$value": 0.88 },
      "title": { "$type": "number", "$value": 1.12 },
      "body": { "$type": "number", "$value": 1.6 },
      "longform": { "$type": "number", "$value": 1.75 }
    }
  },
  "spacing": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "section": { "$type": "dimension", "$value": "clamp(5rem, 9vw, 8.5rem)" },
    "gutter": { "$type": "dimension", "$value": "clamp(1.25rem, 3vw, 4rem)" }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "2px" },
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "12px" },
    "full": { "$type": "dimension", "$value": "999px" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "150ms" },
    "base": { "$type": "duration", "$value": "200ms" },
    "section": { "$type": "duration", "$value": "320ms" }
  }
}
