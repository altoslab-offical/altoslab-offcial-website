      "borderStrong": { "$type": "color", "$value": "rgba(247, 247, 242, 0.22)" },
      "actionPrimary": { "$type": "color", "$value": "{color.primitive.lime500}" },
      "actionPrimaryHover": { "$type": "color", "$value": "{color.primitive.lime400}" },
      "actionPrimaryText": { "$type": "color", "$value": "{color.primitive.blackSoft}" },
      "accentSystem": { "$type": "color", "$value": "{color.primitive.orange500}" },
      "statusError": { "$type": "color", "$value": "{color.primitive.red500}" },
