  "component": {
    "button": {
      "heightSm": { "$type": "dimension", "$value": "2.75rem" },
      "heightMd": { "$type": "dimension", "$value": "3.25rem" },
      "heightLg": { "$type": "dimension", "$value": "4rem" },
      "paddingX": { "$type": "dimension", "$value": "1.5rem" },
      "paddingXLg": { "$type": "dimension", "$value": "2rem" }
    },
    "portfolio": {
      "imageOpacityRest": { "$type": "number", "$value": 0.6 },
      "imageOpacityActive": { "$type": "number", "$value": 0.85 }
