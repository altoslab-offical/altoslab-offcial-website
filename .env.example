CANONICAL_REDIRECT_HOSTS=www.altoslab-ai.cc,altoslab.com,www.altoslab.com,altoslab-offcial-website.vercel.app
ADMIN_PASSWORD=change-this-before-production
ADMIN_SESSION_TOKEN=replace-with-a-long-random-token
# Optional local release verification login for scripts/verify-blog-release.mjs.
ALTOS_ADMIN_PASSWORD=change-this-before-production

# Optional search/social verification meta tags. Add values from each platform dashboard.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
YAHOO_SITE_VERIFICATION=
PINTEREST_SITE_VERIFICATION=
FACEBOOK_DOMAIN_VERIFICATION=

# Legacy manual generator only. The production publish flow uses Gemini copy + GPT covers instead of DeepSeek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CONTENT_MODEL=deepseek-v4-pro
BLOG_TREND_SOURCES=https://developers.google.com/search/blog/rss.xml,https://vercel.com/blog/rss.xml,https://openai.com/news/rss.xml
CRON_SECRET=replace-with-a-random-cron-secret
# Keep legacy DeepSeek cron disabled unless you are intentionally running a migration fallback.
BLOG_DISABLE_DEEPSEEK_CRON=true
# Auto-publishes only when the deterministic quality reviewer and image QA approve the article set.
AUTO_PUBLISH_BLOG=true

# Required by POST /api/admin/blog/ingest-set for the external Gemini + GPT/Codex worker.
BLOG_INGEST_HMAC_SECRET=replace-with-a-long-random-ingest-secret
ALTOS_BLOG_BASE_URL=https://altoslab-ai.cc
ALTOS_BLOG_NODE_BIN=/Users/asdc163/.nvm/versions/node/v22.22.0/bin/node
ALTOS_BLOG_WORKER_RUN_DIR=/Users/asdc163/Documents/官方網站/data/blog-worker-runs
ALTOS_BLOG_WORKER_WAIT_MINUTES=45
# Generated blog covers should be uploaded to Vercel Blob before ingest. Set to 1 only for local fixture tests.
BLOG_IMAGE_ALLOW_NON_BLOB=0
BLOG_IMAGE_VERIFY_REMOTE=true
# Local end-to-end testing only. Production should keep all local fallback paths disabled.
BLOG_IMAGE_ALLOW_LOCAL_HTTP=0
BLOG_MEDIA_ALLOW_LOCAL_STORAGE=0
BLOG_ALLOW_LOCAL_FALLBACK_COVERS=0

# Required for persistent CMS edits and contact leads on Vercel production.
# Vercel Blob is the default durable CMS store for this project.
BLOB_READ_WRITE_TOKEN=

# GCP / Cloud Run production storage. Prefer this for the GCP production path.
GCS_STORAGE_ENABLED=1
GCS_BUCKET=altoslab-official-cms-934551798702
GCS_CMS_PATH=cms/altoslab-cms-v1.json
GCS_MEDIA_PREFIX=blog-generated
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_CLOUD_RUN_SERVICE=altoslab-official-website
# Scheduled runner tries this safe Cloud Run env repair before holding on CMS/GCS drift.
ALTOS_BLOG_PRODUCTION_AUTO_REPAIR=1

# Upstash Redis is also supported and takes priority when configured.
# KV_REST_API_URL / KV_REST_API_TOKEN are also supported aliases.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CMS_STORAGE_KEY=altoslab:cms:v1

# Local development only. Leave disabled in production unless you run a persistent Node server.
CMS_FILE_STORAGE=0
