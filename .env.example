NEXT_PUBLIC_SITE_URL=https://altoslab.com
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
ADMIN_PASSWORD=change-this-before-production
ADMIN_SESSION_TOKEN=replace-with-a-long-random-token

# Optional. When absent or unavailable, the blog generator uses a local bilingual GEO draft template.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CONTENT_MODEL=deepseek-v4-pro
BLOG_TREND_SOURCES=https://developers.google.com/search/blog/rss.xml,https://vercel.com/blog/rss.xml,https://openai.com/news/rss.xml
CRON_SECRET=replace-with-a-random-cron-secret
# Auto-publishes cron posts only when the deterministic quality reviewer approves the bilingual pair.
AUTO_PUBLISH_BLOG=true

# Required for persistent CMS edits and contact leads on Vercel production.
# Vercel Blob is the default durable CMS store for this project.
BLOB_READ_WRITE_TOKEN=

# Upstash Redis is also supported and takes priority when configured.
# KV_REST_API_URL / KV_REST_API_TOKEN are also supported aliases.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CMS_STORAGE_KEY=altoslab:cms:v1

# Local development only. Leave disabled in production unless you run a persistent Node server.
CMS_FILE_STORAGE=0
