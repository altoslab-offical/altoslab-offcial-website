{
  "framework": "nextjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/blog",
      "headers": [
        {
          "key": "Content-Language",
          "value": "zh-Hant-TW"
        }
      ]
    },
    {
      "source": "/blog/(.*)",
      "headers": [
        {
          "key": "Content-Language",
          "value": "zh-Hant-TW"
        }
      ]
    },
    {
      "source": "/en/(.*)",
      "headers": [
        {
          "key": "Content-Language",
          "value": "en"
        }
      ]
    },
    {
      "source": "/ja/(.*)",
      "headers": [
        {
          "key": "Content-Language",
          "value": "ja"
        }
      ]
    },
    {
      "source": "/ko/(.*)",
      "headers": [
        {
          "key": "Content-Language",
          "value": "ko"
        }
      ]
    },
    {
      "source": "/projects",
      "headers": [
        {
          "key": "Content-Language",
          "value": "zh-Hant-TW"
        }
      ]
    },
    {
      "source": "/projects/(.*)",
      "headers": [
        {
          "key": "Content-Language",
          "value": "zh-Hant-TW"
        }
      ]
    }
  ]
}
