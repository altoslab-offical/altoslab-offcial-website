<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.altoslab.n8n-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>zsh</string>
    <string>-lc</string>
    <string>set -a; source "$HOME/.altoslab-blog-worker.env" 2>/dev/null || true; source "$HOME/.altoslab-n8n.env" 2>/dev/null || true; set +a; cd /Users/asdc163/Documents/官方網站 &amp;&amp; "${ALTOS_BLOG_NODE_BIN:-/Users/asdc163/.nvm/versions/node/v22.22.0/bin/node}" scripts/n8n-local-bridge.mjs</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/asdc163/Library/Logs/altoslab-n8n-bridge.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/asdc163/Library/Logs/altoslab-n8n-bridge.err.log</string>
</dict>
</plist>
