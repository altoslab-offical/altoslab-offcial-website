BLOG_INGEST_HMAC_SECRET=replace-with-the-same-secret-configured-on-aws-or-local-runner
ALTOS_BLOG_BASE_URL=https://altoslab-ai.cc
ALTOS_BLOG_NODE_BIN=/Users/asdc163/.nvm/versions/node/v22.22.0/bin/node
ALTOS_ANTIGRAVITY_BIN=/Users/asdc163/.antigravity/antigravity/bin/antigravity
ALTOS_BLOG_WORKER_RUN_DIR=/Users/asdc163/Documents/官方網站/data/blog-worker-runs
ALTOS_BLOG_WORKER_WAIT_MINUTES=45
ALTOS_CHROME_PROFILE_EMAIL=john.wu0120@gmail.com
ALTOS_BLOG_COLUMN_DAILY_LIMIT=3
ALTOS_BLOG_MARKET_SOURCE_PROFILE=longform-ai-news
ALTOS_BLOG_MARKET_NEWS_DEPTH=standard
BLOG_MARKET_TRANSLATION_PROVIDER=google-strict
BLOG_MARKET_ALLOW_LOCAL_TRANSLATION_FALLBACK=0
BLOG_DISABLE_DEEPSEEK_CRON=true
ALTOS_REPORT_FROM_EMAIL=altoslab.offical@gmail.com
ALTOS_REPORT_TO_EMAIL=altoslab.offical@gmail.com
GA4_PROPERTY_ID=539513224
GOOGLE_ANALYTICS_PROPERTY_ID=539513224
GOOGLE_AUTH_MODE=user
GOOGLE_AUTH_ACCOUNT=altoslab.offical@gmail.com
GA4_GOOGLE_OAUTH_CREDENTIALS=
GOOGLE_OAUTH_CREDENTIALS=
GOOGLE_AUTH_USER_CREDENTIALS=
SEARCH_CONSOLE_SITE_URL=https://altoslab-ai.cc/
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://altoslab-ai.cc/

# Active Cloudflare production CMS is D1. KV is still used for generated media and best-effort public cache.
CLOUDFLARE_D1_ENABLED=1
CLOUDFLARE_D1_BINDING=ALTOS_BLOG_D1
CLOUDFLARE_KV_ENABLED=1
CLOUDFLARE_KV_BINDING=ALTOS_BLOG_KV

# Optional durable server-to-server path. Leave empty for local n8n user-auth mode.
GOOGLE_APPLICATION_CREDENTIALS=
GA4_SERVICE_ACCOUNT_JSON=
SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=

# Optional but recommended: lets the post-release verifier perform protected admin readback.
ALTOS_ADMIN_PASSWORD=replace-with-the-production-admin-password

# Local production-server testing only. Keep these disabled for real production publishing.
BLOG_IMAGE_ALLOW_LOCAL_HTTP=0
BLOG_IMAGE_ALLOW_NON_BLOB=0
BLOG_MEDIA_ALLOW_LOCAL_STORAGE=0
