[
  {
    "name": "ALTOS Blog - Cloudflare Health Watch",
    "active": true,
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "minutes",
                "minutesInterval": 30
              }
            ]
          }
        },
        "id": "health-schedule",
        "name": "Every 30 minutes",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          0,
          0
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://host.docker.internal:8797/run/health",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "x-altos-n8n-token",
                "value": "={{ $env.ALTOS_N8N_BRIDGE_TOKEN }}"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\"source\":\"n8n\",\"workflow\":\"cloudflare-health\"}",
          "options": {
            "timeout": 120000
          }
        },
        "id": "health-run",
        "name": "Run Cloudflare health",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          260,
          0
        ]
      }
    ],
    "connections": {
      "Every 30 minutes": {
        "main": [
          [
            {
              "node": "Run Cloudflare health",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "settings": {
      "timezone": "Asia/Taipei",
      "executionOrder": "v1"
    },
    "id": "altos-health-watch"
  },
  {
