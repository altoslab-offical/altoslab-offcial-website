{
  "name": "altoslab-official-website",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:gcp": "NEXT_OUTPUT_STANDALONE=1 next build",
    "build:aws": "NEXT_OUTPUT_STANDALONE=1 next build",
    "build:cloudflare": "node scripts/sync-cloudflare-homepage.mjs && node scripts/prepare-cloudflare-build-dir.mjs --clean-next && NEXT_OUTPUT_STANDALONE=1 next build && node scripts/prepare-cloudflare-build-dir.mjs && opennextjs-cloudflare build --skipNextBuild && node scripts/patch-cloudflare-worker-blog-html.mjs",
    "start": "next start",
    "deploy:gcp": "scripts/gcp-deploy-cloudrun.sh",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "review:design": "node scripts/design-review-gate.mjs",
    "preflight:cloudflare": "npm run review:design && node scripts/preflight-cloudflare-deploy.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && npm run preflight:cloudflare && opennextjs-cloudflare deploy -- --keep-vars",
    "deploy:cloudflare:staging": "npm run build:cloudflare && npm run preflight:cloudflare && npx wrangler deploy --config wrangler.staging.jsonc --keep-vars",
    "cloudflare:whoami": "wrangler whoami",
    "cloudflare:setup": "scripts/cloudflare-free-deploy-setup.sh",
    "cloudflare:setup:staging": "ALTOS_CLOUDFLARE_WRANGLER_CONFIG=wrangler.staging.jsonc ALTOS_CLOUDFLARE_KV_NAMESPACE=ALTOS_BLOG_KV_STAGING scripts/cloudflare-free-deploy-setup.sh",
    "cloudflare:seed-staging-kv": "node scripts/cloudflare-seed-kv.mjs --config wrangler.staging.jsonc --data data/cms.json",
    "cloudflare:migrate-public-blog-cache": "node scripts/cloudflare-migrate-public-blog-cache.mjs",
    "cloudflare:types": "wrangler types --env-interface CloudflareEnv",
    "verify:gcp": "node scripts/gcp-production-smoke.mjs",
    "verify:aws": "node scripts/aws-production-smoke.mjs",
    "aws:migrate-cms": "node scripts/migrate-d1-cms-to-aws-s3.mjs",
    "verify:cloudflare": "node scripts/cloudflare-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test:homepage": "node scripts/homepage-ui-contract-smoke.mjs",
    "test:blog": "node scripts/blog-system-smoke.mjs && node scripts/blog-market-newsroom-smoke.mjs && node scripts/blog-direct-renderer-smoke.mjs && node scripts/blog-ui-contract-smoke.mjs",
    "test:wonda-widget": "node scripts/wonda-widget-smoke.mjs",
    "test:adsense": "node scripts/adsense-smoke.mjs",
    "wonda:language-smoke": "node scripts/wonda-language-smoke.mjs",
    "blog:worker": "node scripts/blog-local-worker.mjs",
    "blog:orchestrate": "node scripts/blog-antigravity-orchestrator.mjs",
    "blog:scheduled": "node scripts/blog-scheduled-runner.mjs",
    "blog:backfill": "node scripts/blog-backfill-planner.mjs",
    "blog:market-sources": "node scripts/blog-market-source-scanner.mjs",
    "blog:media-style-corpus": "node scripts/blog-media-style-corpus.mjs",
    "blog:nine-language-style-corpus": "node scripts/blog-nine-language-style-corpus.mjs",
    "blog:doctor": "node scripts/blog-sop-doctor.mjs",
    "blog:verify-release": "node scripts/verify-blog-release.mjs",
    "blog:install-agent": "scripts/install-blog-launch-agent.sh",
    "blog:performance-smoke": "node scripts/blog-performance-smoke.mjs",
    "seo:geo-report": "node scripts/seo-geo-insight-report.mjs",
    "blog:traffic-self-evolution": "node scripts/blog-traffic-self-evolution.mjs",
    "blog:codex-column-producer": "node scripts/blog-codex-column-producer.mjs",
    "test": "npm run review:design && npm run typecheck && npm run test:homepage && npm run test:blog && npm run test:wonda-widget && npm run test:adsense",
    "blog:market-scan": "node scripts/blog-scheduled-runner.mjs --market-scan",
    "blog:market-worker": "node scripts/blog-market-source-worker.mjs",
    "blog:market-public-qa": "node scripts/blog-market-news-public-qa.mjs",
    "blog:audit-ai-feeling": "node scripts/blog-audit-ai-feeling.mjs",
    "blog:repair-copy": "node scripts/blog-public-copy-repair.mjs",
    "blog:clean-public-market": "node scripts/blog-clean-public-market-news-projection.mjs",
    "blog:repair-production": "node scripts/blog-production-repair.mjs",
    "blog:ops-audit": "node scripts/blog-operations-audit.mjs",
    "blog:daily-closeout": "node scripts/blog-daily-closeout.mjs",
    "blog:market-fill": "node scripts/blog-scheduled-runner.mjs --market-fill",
    "blog:column-worklist": "node scripts/blog-column-production-worklist.mjs",
    "gmail:token": "node scripts/gmail-oauth-token.mjs",
    "google:oauth-user": "node scripts/google-oauth-user-login.mjs",
    "n8n:verify-local": "scripts/verify-n8n-local-control-plane.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1071.0",
    "@next/third-parties": "^16.2.6",
    "@opennextjs/cloudflare": "^1.19.11",
    "@vercel/blob": "^2.4.0",
    "lucide-react": "latest",
    "next": "latest",
    "postcss": "^8.5.10",
    "react": "latest",
    "react-dom": "latest"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "wrangler": "^4.95.0"
  }
}
