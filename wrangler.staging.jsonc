{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "altoslab-official-website-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-31",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "altoslab-official-website-staging"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ALTOS_BLOG_KV",
      "id": "246977568bf14ed0916a21eedbdbdbc1"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://altoslab-official-website-staging.altoslab-ai.workers.dev",
    "NEXT_PUBLIC_GTM_ID": "GTM-WJ96VR7V",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-5VSLFNVD28",
    "CANONICAL_REDIRECT_HOSTS": "www.altoslab-ai.cc,altoslab.com,www.altoslab.com,altoslab-offcial-website.vercel.app,altoslab-offcial-website-altoslaboffical-3015s-projects.vercel.app",
    "CMS_STORAGE_KEY": "altoslab:cms:v1",
    "CLOUDFLARE_KV_ENABLED": "1",
    "CLOUDFLARE_KV_BINDING": "ALTOS_BLOG_KV",
    "CLOUDFLARE_R2_ENABLED": "0",
    "CLOUDFLARE_R2_BINDING": "ALTOS_BLOG_R2",
    "AUTO_PUBLISH_BLOG": "true",
    "ALTOS_BLOG_COLUMN_DAILY_LIMIT": "3",
    "BLOG_DISABLE_DEEPSEEK_CRON": "true",
    "BLOG_IMAGE_ALLOW_NON_BLOB": "0",
    "BLOG_IMAGE_VERIFY_REMOTE": "true",
    "BLOG_MEDIA_ALLOW_LOCAL_STORAGE": "0"
  }
}
